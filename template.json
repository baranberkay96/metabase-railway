{
  "name": "Metabase BI Dashboards (Postgres)",
  "description": "Open-source BI: SQL and no-code questions, dashboards, alerts. Postgres DB.",
  "category": "Analytics",
  "tags": [
    "metabase",
    "bi",
    "business-intelligence",
    "dashboards",
    "analytics",
    "sql",
    "data-visualization"
  ],
  "image": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/metabase.svg",
  "services": {
    "Metabase": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/metabase.svg",
      "source": {
        "repo": "baranberkay96/metabase-railway",
        "rootDirectory": "/services/metabase"
      },
      "healthcheckPath": "/api/health",
      "healthcheckTimeout": 900,
      "restartPolicyType": "ALWAYS",
      "publicDomain": true,
      "targetPort": 3000,
      "variables": {
        "PORT": {
          "defaultValue": "3000",
          "description": "Port Metabase listens on (domain and healthcheck).",
          "required": false
        },
        "MB_JETTY_PORT": {
          "defaultValue": "3000",
          "description": "Metabase web server port.",
          "required": false
        },
        "MB_SITE_URL": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public URL used in links and emails. Update for a custom domain.",
          "required": true
        },
        "METABASE_ADMIN_EMAIL": {
          "defaultValue": "admin@example.com",
          "description": "Login email of the administrator created on first start (your own address works best).",
          "required": false
        },
        "METABASE_ADMIN_PASSWORD": {
          "defaultValue": "${{secret(20, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}${{secret(4, \"0123456789\")}}",
          "description": "Administrator password, applied on first start only. Change it later in Account settings.",
          "required": false
        },
        "METABASE_AUTO_SETUP": {
          "defaultValue": "true",
          "description": "Create the administrator automatically (recommended). false = first visitor runs the setup wizard.",
          "required": false
        },
        "METABASE_SITE_NAME": {
          "defaultValue": "Metabase",
          "description": "Site name set during the automatic setup.",
          "required": false
        },
        "MB_DB_TYPE": {
          "defaultValue": "postgres",
          "description": "Application database type (Postgres, never the embedded H2).",
          "required": true
        },
        "MB_DB_HOST": {
          "defaultValue": "${{Postgres.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Postgres host on the private network.",
          "required": true
        },
        "MB_DB_PORT": {
          "defaultValue": "5432",
          "description": "Postgres port.",
          "required": false
        },
        "MB_DB_DBNAME": {
          "defaultValue": "${{Postgres.PGDATABASE}}",
          "description": "Application database name.",
          "required": true
        },
        "MB_DB_USER": {
          "defaultValue": "${{Postgres.PGUSER}}",
          "description": "Application database user.",
          "required": true
        },
        "MB_DB_PASS": {
          "defaultValue": "${{Postgres.PGPASSWORD}}",
          "description": "Application database password.",
          "required": true
        },
        "MB_ENCRYPTION_SECRET_KEY": {
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Encrypts saved database credentials in the app DB. Never change or lose it.",
          "required": true
        },
        "MB_ANON_TRACKING_ENABLED": {
          "defaultValue": "false",
          "description": "Anonymous usage statistics to Metabase.",
          "required": false
        },
        "MB_CHECK_FOR_UPDATES": {
          "defaultValue": "true",
          "description": "Show a notice when a newer Metabase version exists.",
          "required": false
        },
        "JAVA_TIMEZONE": {
          "defaultValue": "UTC",
          "description": "JVM time zone (report timestamps).",
          "required": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "30",
          "description": "Time running queries get to finish on redeploy.",
          "required": false
        }
      }
    },
    "Postgres": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/postgresql.svg",
      "source": {
        "image": "ghcr.io/railwayapp-templates/postgres-ssl:18.6@sha256:4fc833b43d2aaf6ecc9b18615f5533602b723a32d0e2efe2dae8ca0f7217c863"
      },
      "restartPolicyType": "ALWAYS",
      "publicDomain": false,
      "volume": {
        "mountPath": "/var/lib/postgresql/data"
      },
      "variables": {
        "PGDATA": {
          "defaultValue": "/var/lib/postgresql/data/pgdata",
          "description": "Location where the database will be initialized",
          "required": true
        },
        "PGHOST": {
          "defaultValue": "${{RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Railway Private Domain Name.",
          "required": true
        },
        "PGPORT": {
          "defaultValue": "5432",
          "description": "Port to connect to Postgres.",
          "required": true
        },
        "PGUSER": {
          "defaultValue": "${{ POSTGRES_USER }}",
          "description": "Required variable for Data panel",
          "required": true
        },
        "PGDATABASE": {
          "defaultValue": "${{POSTGRES_DB}}",
          "description": "Required variable for the data panel.",
          "required": true
        },
        "PGPASSWORD": {
          "defaultValue": "${{POSTGRES_PASSWORD}}",
          "description": "Required variable for Data panel",
          "required": true
        },
        "POSTGRES_DB": {
          "defaultValue": "railway",
          "description": "Default database created when image is started.",
          "required": true
        },
        "DATABASE_URL": {
          "defaultValue": "postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}",
          "description": "URL to connect to Postgres (Metabase application database).",
          "required": true
        },
        "POSTGRES_USER": {
          "defaultValue": "postgres",
          "description": "User to connect to Postgres DB",
          "required": true
        },
        "SSL_CERT_DAYS": {
          "defaultValue": "820",
          "description": "SSL certificate expiry in days.",
          "required": false
        },
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{ secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\") }}",
          "description": "Password to connect to DB",
          "required": true
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "60",
          "description": "Allow Postgres to cleanly shut down",
          "required": true
        }
      }
    }
  },
  "idSeed": "Metabase 65 BI Dashboards (Postgres)"
}
